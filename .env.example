# Copy this file to ".env" and paste your free API keys.

# Finnhub — realtime single-stock quotes, search, and adding new stocks.
# Get one at https://finnhub.io (sign up, then copy your API key).
# Without a key, the app uses realistic placeholder prices.
VITE_FINNHUB_KEY=

# Financial Modeling Prep (FMP) — batch quotes for the browse list (one call for ALL
# stocks, instead of one-per-stock). Big rate-limit saver.
# Get one free at https://site.financialmodelingprep.com (sign up, copy your API key).
# Without a key, bulk quotes fall back to Finnhub per-symbol.
VITE_FMP_KEY=

# Twelve Data — historical charts (Day/Week/Month/Year) on each stock.
# Get one free at https://twelvedata.com (sign up, then copy your API key).
# Without a key, the charts show realistic demo history instead.
VITE_TWELVEDATA_KEY=
