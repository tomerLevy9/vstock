# Copy this file to ".env" and paste your free API keys.

# Finnhub — live prices, search, and adding new stocks.
# Get one at https://finnhub.io (sign up, then copy your API key).
# Without a key, the app uses realistic placeholder prices.
VITE_FINNHUB_KEY=

# Twelve Data — historical charts (Day/Week/Month/Year) on each stock.
# Get one free at https://twelvedata.com (sign up, then copy your API key).
# Without a key, the charts show realistic demo history instead.
VITE_TWELVEDATA_KEY=
